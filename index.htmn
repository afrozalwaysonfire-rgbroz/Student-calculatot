<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Student Calculator</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    padding:20px;
    background:#eef2ff;
    font-family:Arial,sans-serif;
}

.app{
    width:100%;
    max-width:450px;
    margin:auto;
}

h1{
    text-align:center;
    color:#172554;
    margin-bottom:5px;
}

.subtitle{
    text-align:center;
    color:#64748b;
    margin-bottom:20px;
}

.calculator{
    background:#ffffff;
    padding:15px;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,.12);
}

.screen{
    background:#111827;
    color:white;
    border-radius:15px;
    padding:20px;
    text-align:right;
    margin-bottom:15px;
    min-height:100px;
}

#old{
    color:#94a3b8;
    font-size:16px;
    min-height:25px;
}

#display{
    font-size:35px;
    font-weight:bold;
    overflow:auto;
}

.keys{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:8px;
}

button{
    border:none;
    padding:18px 5px;
    border-radius:12px;
    font-size:19px;
    font-weight:bold;
    background:#e2e8f0;
}

button:active{
    transform:scale(.95);
}

.operator{
    background:#bfdbfe;
    color:#1e3a8a;
}

.clear{
    background:#fecaca;
    color:#991b1b;
}

.equal{
    background:#2563eb;
    color:white;
}

.tools{
    margin-top:18px;
    background:white;
    padding:15px;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
}

.tools h2{
    margin-top:0;
    color:#172554;
}

input,select{
    width:100%;
    padding:13px;
    margin:6px 0;
    border:1px solid #cbd5e1;
    border-radius:10px;
    font-size:16px;
}

.toolbutton{
    width:100%;
    background:#2563eb;
    color:white;
    margin-top:7
